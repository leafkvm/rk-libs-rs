# Load any .envrc files all the way till /
source_up

# Load .env file if exists
dotenv_if_exists

export PROJECT_ROOT=$(expand_path .)
export BUILDROOT_DIR="${BUILDROOT_DIR:-$(expand_path ../buildroot)}"
export BUILDROOT_OUTPUT="${BUILDROOT_OUTPUT:-${BUILDROOT_DIR}/output}"
export BUILDROOT_HOST_DIR="${BUILDROOT_OUTPUT}/host"
export BUILDROOT_STAGING_DIR="${BUILDROOT_OUTPUT}/staging"

if [ ! -d "$BUILDROOT_OUTPUT" ]; then
    log_error "Buildroot output directory not found at: $BUILDROOT_OUTPUT"
fi

export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER="${BUILDROOT_HOST_DIR}/bin/aarch64-linux-gcc"
export CARGO_BUILD_TARGET="aarch64-unknown-linux-gnu"

export PKG_CONFIG_SYSROOT_DIR="${BUILDROOT_STAGING_DIR}"
export PKG_CONFIG="${BUILDROOT_HOST_DIR}/bin/pkg-config"

export BINDGEN_EXTRA_CLANG_ARGS="--sysroot=${BUILDROOT_STAGING_DIR} --gcc-install-dir=${BUILDROOT_HOST_DIR}/opt/ext-toolchain/lib/gcc/aarch64-buildroot-linux-gnu/14.3.0"
export CARGO_INCREMENTAL="1"
export RUSTFLAGS="-C target-cpu=cortex-a53"

# Paste this into VS Code settings to mirror the cargo env from direnv.
export VSCODE_CARGO_CONFIG="$(
python3 - <<'PY'
import json
import os

extra_env = {
    key: os.environ[key]
    for key in (
        "BINDGEN_EXTRA_CLANG_ARGS",
        "CARGO_BUILD_TARGET",
        "CARGO_INCREMENTAL",
        "CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER",
        "PKG_CONFIG",
        "PKG_CONFIG_SYSROOT_DIR",
        "RUSTFLAGS",
    )
    if key in os.environ
}

print('"rust-analyzer.cargo.extraEnv": ' + json.dumps(extra_env, ensure_ascii=False, indent=4, sort_keys=True))
PY
)"
